<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Ticket #<%= ticket.number %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<style>
  :root {
    --bg-dark: #1e1f23;
    --card-bg: #282a36;
    --text-light: #f8f8f2;
    --accent: #8be9fd;
  }
  body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    font-family: 'Segoe UI', sans-serif;
  }
  .card-box {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
  }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .ficha-label { color: #6272a4; font-size: .85rem; }
  .valor-texto { white-space: pre-wrap; overflow-wrap: anywhere; }
  .msg { padding: 8px 0; border-bottom: 1px solid #44475a; }
  .msg:last-child { border-bottom: 0; }
  .msg-conteudo { white-space: pre-wrap; overflow-wrap: anywhere; }
  .autor-jogador { color: #50fa7b; }
  .autor-staff { color: #ffb86c; }
  .autor-bot { color: #bd93f9; }
  .msg-quando { color: #6272a4; font-size: .8rem; }
  .msg img, .msg video { max-width: 100%; max-height: 360px; border-radius: 8px; margin-top: 6px; }
</style>
</head>
<body>
  <%- include('../../partials/navbar.ejs') %>
  <div class="container py-4">
    <p><a href="/tickets"><i class="fa-solid fa-arrow-left me-1"></i> Voltar para a lista</a></p>

    <div class="card-box">
      <h1 class="h4 mb-3">
        Ticket #<%= ticket.number %>
        <span class="badge <%= ticket.status === "open" ? "bg-success" : "bg-secondary" %> ms-2"><%= ticket.status === "open" ? "Aberto" : "Fechado" %></span>
      </h1>
      <div class="row g-2">
        <div class="col-md-4"><span class="ficha-label">Categoria</span><br><%= ticket.categoria %></div>
        <div class="col-md-4"><span class="ficha-label">Jogador</span><br><a href="/tickets/jogador/<%= ticket.jogador.id %>"><%= ticket.jogador.nome %></a></div>
        <div class="col-md-4">
          <span class="ficha-label">Atendente</span><br>
          <% if (ticket.assumidoPor) { %><a href="/tickets/staff/<%= ticket.assumidoPor.id %>"><%= ticket.assumidoPor.nome %></a><% } else { %>-<% } %>
        </div>
        <div class="col-md-4">
          <span class="ficha-label">Superiores</span><br>
          <% if (ticket.superiores.length === 0) { %>-<% } %>
          <% ticket.superiores.forEach((s, i) => { %><a href="/tickets/staff/<%= s.id %>"><%= s.nome %></a><%= i < ticket.superiores.length - 1 ? ", " : "" %><% }) %>
        </div>
        <div class="col-md-4">
          <span class="ficha-label">Fechado por</span><br>
          <% if (ticket.fechadoPor) { %><a href="/tickets/staff/<%= ticket.fechadoPor.id %>"><%= ticket.fechadoPor.nome %></a><% } else { %>-<% } %>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-lg-6">
        <div class="card-box">
          <h2 class="h5 mb-3">Ficha</h2>
          <% if (ticket.ficha.length === 0) { %>
            <p class="text-secondary mb-0">Sem respostas registradas.</p>
          <% } %>
          <% ticket.ficha.forEach((f) => { %>
            <div class="mb-2">
              <div class="ficha-label"><%= f.label %></div>
              <div class="valor-texto"><%= f.value %></div>
            </div>
          <% }) %>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="card-box">
          <h2 class="h5 mb-3">Tempos</h2>
          <div>Aberto em: <%= ticket.abertoEm %></div>
          <div>Assumido em: <%= ticket.assumidoEm ?? "-" %> <span class="text-secondary">(<%= ticket.tempoAteAssumir ?? "-" %>)</span></div>
          <div>Fechado em: <%= ticket.fechadoEm ?? "-" %> <span class="text-secondary">(<%= ticket.tempoAteFechar ?? "-" %> no total)</span></div>
        </div>
        <div class="card-box">
          <h2 class="h5 mb-3">Avaliação</h2>
          <% if (ticket.avaliacao.length === 0) { %>
            <p class="text-secondary mb-0">Não avaliado</p>
          <% } %>
          <% ticket.avaliacao.forEach((a) => { %>
            <div><span class="ficha-label"><%= a.pergunta %></span><br><strong><%= a.resposta %></strong></div>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="card-box">
      <h2 class="h5 mb-3">Conversa <% if (conversaAoVivo) { %><span class="badge bg-info text-dark">ao vivo</span><% } %></h2>
      <% if (ticket.canalApagadoSemTranscricao) { %>
        <div class="alert alert-warning">Canal apagado sem transcrição</div>
      <% } %>
      <% if (erroConversa) { %>
        <div class="alert alert-warning"><%= erroConversa %></div>
      <% } %>
      <div id="conversa" data-ticket-id="<%= ticket.id %>">
        <% if (conversa.length === 0 && !ticket.canalApagadoSemTranscricao && !erroConversa) { %>
          <p class="text-secondary mb-0">Nenhuma mensagem.</p>
        <% } %>
        <% conversa.forEach((m) => { %>
          <div class="msg">
            <strong class="autor-<%= m.autor.papel %>"><%= m.autor.tag %></strong>
            <span class="msg-quando ms-2"><%= m.quando %></span>
            <% if (m.conteudo) { %><div class="msg-conteudo"><%= m.conteudo %></div><% } %>
            <% m.anexos.forEach((a) => { %>
              <div>
                <% if (a.local && /\.(png|jpe?g|gif|webp)$/i.test(a.nome)) { %>
                  <a href="<%= a.url %>" target="_blank" rel="noopener"><img src="<%= a.url %>" alt="<%= a.nome %>" loading="lazy"></a>
                <% } else { %>
                  <a href="<%= a.url %>" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-paperclip me-1"></i><%= a.nome %></a>
                  <% if (!a.local) { %><span class="text-secondary">(link do Discord, pode ter expirado)</span><% } %>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
  <script src="/tickets.js" defer></script>
</body>
</html>
