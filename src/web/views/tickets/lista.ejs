<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tickets</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<style>
  :root {
    --bg-dark: #1e1f23;
    --card-bg: #282a36;
    --text-light: #f8f8f2;
    --accent: #8be9fd;
  }
  body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    font-family: 'Segoe UI', sans-serif;
  }
  .card-box {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .table { --bs-table-bg: transparent; --bs-table-color: var(--text-light); --bs-table-border-color: #44475a; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .page-link { background: var(--card-bg); border-color: #44475a; color: var(--accent); }
  .page-item.active .page-link { background: #6272a4; border-color: #6272a4; color: #fff; }
  .page-item.disabled .page-link { background: var(--card-bg); border-color: #44475a; color: #6c757d; }
</style>
</head>
<body>
  <%- include('../../partials/navbar.ejs') %>
  <%
    const qs = new URLSearchParams();
    for (const chave of ["status", "categoria", "atendente", "de", "ate", "jogador"]) {
      if (filtros[chave]) qs.set(chave, filtros[chave]);
    }
    const linkPagina = (n) => { const p = new URLSearchParams(qs); p.set("pagina", String(n)); return "/tickets?" + p.toString(); };
  %>
  <div class="container py-4">
    <h1 class="h3 mb-4"><i class="fa-solid fa-ticket me-2"></i> Tickets</h1>

    <% if (aviso) { %>
      <div class="alert alert-warning"><%= aviso %></div>
    <% } %>

    <form method="get" action="/tickets" class="card-box row g-3 align-items-end">
      <div class="col-md-2">
        <label class="form-label" for="f-status">Status</label>
        <select class="form-select" id="f-status" name="status">
          <option value="">Todos</option>
          <option value="open" <%= filtros.status === "open" ? "selected" : "" %>>Aberto</option>
          <option value="closed" <%= filtros.status === "closed" ? "selected" : "" %>>Fechado</option>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="f-categoria">Categoria</label>
        <select class="form-select" id="f-categoria" name="categoria">
          <option value="">Todas</option>
          <% categorias.forEach((c) => { %>
            <option value="<%= c.id %>" <%= filtros.categoria === c.id ? "selected" : "" %>><%= c.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-3">
        <label class="form-label" for="f-atendente">Atendente</label>
        <select class="form-select" id="f-atendente" name="atendente">
          <option value="">Todos</option>
          <% atendentes.forEach((a) => { %>
            <option value="<%= a.id %>" <%= filtros.atendente === a.id ? "selected" : "" %>><%= a.nome %></option>
          <% }) %>
        </select>
      </div>
      <div class="col-md-2">
        <label class="form-label" for="f-de">De</label>
        <input type="date" class="form-control" id="f-de" name="de" value="<%= filtros.de || "" %>">
      </div>
      <div class="col-md-2">
        <label class="form-label" for="f-ate">Até</label>
        <input type="date" class="form-control" id="f-ate" name="ate" value="<%= filtros.ate || "" %>">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="f-jogador">Jogador (nick ou ID)</label>
        <input type="text" class="form-control" id="f-jogador" name="jogador" value="<%= filtros.jogador || "" %>">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i> Filtrar</button>
        <a href="/tickets" class="btn btn-outline-secondary">Limpar</a>
      </div>
    </form>

    <div class="card-box">
      <p class="text-secondary mb-3"><%= total %> ticket(s)</p>
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead>
            <tr>
              <th>Nº</th><th>Categoria</th><th>Jogador</th><th>Status</th><th>Assumido por</th>
              <th>Superiores</th><th>Aberto em</th><th>Até assumir</th><th>Até fechar</th><th>Nota</th>
            </tr>
          </thead>
          <tbody>
            <% if (itens.length === 0) { %>
              <tr><td colspan="10" class="text-center text-secondary">Nenhum ticket encontrado.</td></tr>
            <% } %>
            <% itens.forEach((t) => { %>
              <tr data-ticket-id="<%= t.id %>">
                <td><a href="/tickets/<%= t.id %>">#<%= t.number %></a></td>
                <td><%= t.categoria %></td>
                <td><a href="/tickets/jogador/<%= t.jogador.id %>"><%= t.jogador.nome %></a></td>
                <td>
                  <% if (t.status === "open") { %>
                    <span class="badge bg-success">aberto</span>
                  <% } else { %>
                    <span class="badge bg-secondary">fechado</span>
                  <% } %>
                  <% if (t.canalApagado) { %>
                    <span class="badge bg-dark border border-secondary">canal apagado</span>
                  <% } %>
                </td>
                <td>
                  <% if (t.assumidoPor) { %>
                    <a href="/tickets/staff/<%= t.assumidoPor.id %>"><%= t.assumidoPor.nome %></a>
                  <% } else { %>-<% } %>
                </td>
                <td>
                  <% if (t.superiores.length === 0) { %>-<% } %>
                  <% t.superiores.forEach((s, i) => { %><% if (i > 0) { %>, <% } %><a href="/tickets/staff/<%= s.id %>"><%= s.nome %></a><% }) %>
                </td>
                <td><%= t.abertoEm %></td>
                <td><%= t.tempoAteAssumir ?? "-" %></td>
                <td><%= t.tempoAteFechar ?? "-" %></td>
                <td><%= t.nota ?? "-" %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (totalPaginas > 1) { %>
      <nav aria-label="Paginação">
        <ul class="pagination justify-content-center mb-0">
          <li class="page-item <%= pagina <= 1 ? "disabled" : "" %>"><a class="page-link" href="<%= linkPagina(pagina - 1) %>">Anterior</a></li>
          <li class="page-item active"><span class="page-link">Página <%= pagina %> de <%= totalPaginas %></span></li>
          <li class="page-item <%= pagina >= totalPaginas ? "disabled" : "" %>"><a class="page-link" href="<%= linkPagina(pagina + 1) %>">Próxima</a></li>
        </ul>
      </nav>
      <% } %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
