<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tickets - Jogador</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<style>
  :root {
    --bg-dark: #1e1f23;
    --card-bg: #282a36;
    --text-light: #f8f8f2;
    --accent: #8be9fd;
  }
  body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    font-family: 'Segoe UI', sans-serif;
  }
  .card-box {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .table { --bs-table-bg: transparent; --bs-table-color: var(--text-light); --bs-table-border-color: #44475a; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
</head>
<body>
  <%- include('../../partials/navbar.ejs') %>
  <div class="container py-4">
    <p class="mb-2"><a href="/tickets"><i class="fa-solid fa-arrow-left me-1"></i> Tickets</a></p>
    <h1 class="h3 mb-4"><i class="fa-solid fa-user me-2"></i> <%= jogador.nome %></h1>

    <div class="card-box">
      <div class="row g-3">
        <div class="col-6 col-md-3"><div class="text-secondary small">Total</div><div class="h4 mb-0"><%= contagem.total %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Abertos</div><div class="h4 mb-0"><%= contagem.abertos %></div></div>
      </div>
      <% const categorias = Object.entries(contagem.porCategoria); %>
      <% if (categorias.length > 0) { %>
        <hr>
        <ul class="list-unstyled mb-0">
          <% categorias.forEach(([rotulo, qtd]) => { %>
            <li><%= rotulo %>: <%= qtd %></li>
          <% }) %>
        </ul>
      <% } %>
    </div>

    <div class="card-box">
      <p class="text-secondary mb-3"><%= contagem.total %> ticket(s)</p>
<%- include('_tabela', { itens: tickets }) %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
