<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Tickets - Atendente</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet">
<style>
  :root {
    --bg-dark: #1e1f23;
    --card-bg: #282a36;
    --text-light: #f8f8f2;
    --accent: #8be9fd;
  }
  body {
    background-color: var(--bg-dark);
    color: var(--text-light);
    font-family: 'Segoe UI', sans-serif;
  }
  .card-box {
    background: var(--card-bg);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 20px;
  }
  .table { --bs-table-bg: transparent; --bs-table-color: var(--text-light); --bs-table-border-color: #44475a; }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
</style>
</head>
<body>
  <%- include('../../partials/navbar.ejs') %>
  <%
    const fmt = (v) => (v === null || v === undefined ? "-" : String(v));
    const nota = (v) => (v === null || v === undefined ? "-" : Number(v).toFixed(1));
    const pct = (v) => (v === null || v === undefined ? "-" : Math.round(v) + "%");
    const sufixo = (n) => (n > 0 ? " (" + n + " avaliações)" : "");
  %>
  <div class="container py-4">
    <p class="mb-2"><a href="/tickets/staff?de=<%= periodo.de %>&amp;ate=<%= periodo.ate %>"><i class="fa-solid fa-arrow-left me-1"></i> Ranking da staff</a></p>
    <h1 class="h3 mb-1"><i class="fa-solid fa-user-shield me-2"></i> <%= atendente.nome %></h1>
    <p class="text-secondary mb-4">Tickets fechados de <%= periodo.label %></p>

    <form method="get" action="/tickets/staff/<%= atendente.id %>" class="card-box row g-3 align-items-end">
      <div class="col-md-3">
        <label class="form-label" for="f-de">De</label>
        <input type="date" class="form-control" id="f-de" name="de" value="<%= periodo.de %>">
      </div>
      <div class="col-md-3">
        <label class="form-label" for="f-ate">Até</label>
        <input type="date" class="form-control" id="f-ate" name="ate" value="<%= periodo.ate %>">
      </div>
      <div class="col-md-3">
        <button type="submit" class="btn btn-primary"><i class="fa-solid fa-filter me-1"></i> Aplicar</button>
      </div>
    </form>

    <div class="card-box">
      <div class="row g-3">
        <div class="col-6 col-md-3"><div class="text-secondary small">Atendidos</div><div class="h4 mb-0"><%= metricas.atendidos %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Avaliados</div><div class="h4 mb-0"><%= metricas.avaliados %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Resolvido</div><div class="h4 mb-0"><%= pct(metricas.resolvidoPct) %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Como superior</div><div class="h4 mb-0"><%= metricas.comoSuperior %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Atendimento</div><div class="h5 mb-0"><%= nota(metricas.atendimentoMedia) %><%= sufixo(metricas.avaliados) %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Rapidez</div><div class="h5 mb-0"><%= nota(metricas.tempoMedia) %><%= sufixo(metricas.avaliados) %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Até assumir (média)</div><div class="h5 mb-0"><%= fmt(metricas.mediaAteAssumir) %></div></div>
        <div class="col-6 col-md-3"><div class="text-secondary small">Até fechar (média)</div><div class="h5 mb-0"><%= fmt(metricas.mediaAteFechar) %></div></div>
      </div>
    </div>

    <div class="card-box">
      <p class="text-secondary mb-3">
        <% if (totalTickets > tickets.length) { %>
          Mostrando os <%= tickets.length %> mais recentes de <%= totalTickets %> ticket(s)
        <% } else { %>
          <%= totalTickets %> ticket(s)
        <% } %>
      </p>
<%- include('_tabela', { itens: tickets }) %>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
